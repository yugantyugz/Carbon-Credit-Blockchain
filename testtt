=IFERROR(
    CHOOSECOLS(
        FILTER(
            Credit,
            MMULT(
                (
                    (Credit[[IG UNITED KINGDOM]:[NIG CAYMAN ISLANDS]] > 0)
                    * (Credit[[IG UNITED KINGDOM]:[NIG CAYMAN ISLANDS]] > IFNA(VLOOKUP(
                        IF(LEFT(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),3)="NIG","NIG ","IG ") &
                        TRIM(MID(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),4,99)),
                        'Credit Threshold'!$D$10:$P$43,
                        IF(LEFT(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),3)="NIG",2,4),
                        FALSE
                    ),$A$19))
                )
                + (
                    (Credit[[IG UNITED KINGDOM]:[NIG CAYMAN ISLANDS]] < IFNA(VLOOKUP(
                        IF(LEFT(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),3)="NIG","NIG ","IG ") &
                        TRIM(MID(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),4,99)),
                        'Credit Threshold'!$D$10:$P$43,
                         IF(LEFT(INDEX(Credit[#Headers],1,COLUMN()-COLUMN(Credit[[#Headers],[IG UNITED KINGDOM]])+1),3)="NIG",3,5),
                        FALSE
                    ),-$A$19))
                ),
                SEQUENCE(COLUMNS(Credit[[IG UNITED KINGDOM]:[NIG CAYMAN ISLANDS]]),,1,0)
            ) > 0
        ),
        3, 4, 19, 20, 33, 197
    ),
    "No Names above threshold"
)
